# Copy this file to .env.local for local development (Vite auto-loads .env.local).
# In Netlify, set these as Site configuration -> Environment variables instead.
#
# Get both values from your Supabase project: Project Settings -> API.
# VITE_SUPABASE_URL is the "Project URL".
# VITE_SUPABASE_ANON_KEY is the "anon" / "publishable" public key (safe to
# expose in a browser bundle -- it only grants what your RLS policies allow).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
